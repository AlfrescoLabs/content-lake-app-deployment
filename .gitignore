# Local environment overrides
.env.local
*.bak

# Docker Compose auto-merges a file with this name into every command run from this
# directory. Keep local service tweaks in .env.local instead, so a run's configuration
# is visible in the compose files it names.
compose.override.yaml
compose.override.yml

# Drop directory mounted by the opt-in filesystem profile (FILESYSTEM_HOST_PATH)
filesystem-data/

# Delegated SharePoint token cache, written by scripts/sharepoint-device-login.sh and mounted read-only into
# plugin-batch-ingester. It holds a refresh token, which outlives the access tokens it mints and can be
# redeemed from anywhere, so it is a credential and never belongs in a commit. The directory's .gitkeep stays
# tracked so the bind mount has something to mount on a fresh checkout.
sharepoint-auth/*
!sharepoint-auth/.gitkeep

# macOS
.DS_Store

# Docker build artifacts
*.tar
*.log

# Self-signed certificates (generated by scripts/generate-local-cert.sh).
# The .gitkeep keeps nginx/certs/local in the checkout, so the proxy bind mount
# doesn't make Docker create the directory as root.
nginx/certs/local/*
!nginx/certs/local/.gitkeep

# Connector jars dropped into the plugin directory. They are build artefacts of a project outside this
# repository, and test-connector.sh and test-cmis.sh both copy one in and delete it again, so a
# `git add -A` mid-run otherwise commits one. The directory's README is tracked; nothing else in it is.
connectors/*.jar
