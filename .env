# Alfresco Content Lake deployment defaults.
# To override values locally, create a .env.local file and run via the Makefile
# (make up / make down / etc.) — it passes --env-file .env.local automatically.
# When using docker compose directly, pass the flag explicitly:
#   docker compose --env-file .env.local up --build

# Alfresco platform
SERVER_NAME=localhost
ALFRESCO_CE_TAG=26.2.0
SHARE_TAG=26.1.0
CONTROL_CENTER_TAG=10.2.0
POSTGRES_TAG=15.6
TRANSFORM_ENGINE_TAG=5.4.3
ACTIVEMQ_TAG=6.2.1-jre17-rockylinux8

# Credentials
ALFRESCO_ADMIN_USER=admin
ALFRESCO_ADMIN_PASSWORD=admin
POSTGRES_USER=alfresco
POSTGRES_PASSWORD=alfresco
POSTGRES_DB=alfresco
SHARED_SECRET=3uux2z0blli
ACTIVEMQ_USER=admin
ACTIVEMQ_PASSWORD=admin
HXPR_REPOSITORY_ID=default
HXPR_TARGET_PATH=/alfresco-sync
NUXEO_USERNAME=Administrator
NUXEO_PASSWORD=Administrator
NUXEO_SOURCE_ID=local

# RAG Service - Permission source IDs (comma-separated list of source IDs).
# Used to namespace the permission-filter ACL clauses (g:GROUP_x_#_<sourceId>).
# LEAVE EMPTY in almost all cases: rag-service then auto-discovers Alfresco source
# IDs from the index and uses NUXEO_SOURCE_ID for Nuxeo. This is the only correct
# default for Alfresco, whose source ID is the live repository UUID (e.g.
# de0b9044-...) and is NOT "default" -- pinning "default" silently hides
# group/user-restricted Alfresco documents from search.
# Only set this to restrict a RAG instance to a subset of sources, and then only
# with the REAL source IDs (the Alfresco repository UUID and/or NUXEO_SOURCE_ID).
RAG_PERMISSION_SOURCE_IDS=

# Alfresco repository-side ACL reconciliation
CONTENT_LAKE_PERMISSION_SYNC_ENABLED=true
CONTENT_LAKE_PERMISSION_SYNC_BROKER_URL=tcp://activemq:61616
CONTENT_LAKE_PERMISSION_SYNC_QUEUE_NAME=contentlake.acl.changed

# Alfresco batch-ingester scope
# Root folder for the configured batch sync (/api/sync/configured).
# Use Alfresco special aliases (-root-, -my-, -shared-) or a node UUID.
# Defaults to -root- (full repository). Override to narrow the sync scope.
INGESTION_FOLDER_1=-root-

# HXPR and supporting infrastructure
HXPR_LOCAL_IMAGE=content-lake-app/hxpr-app:local
HXPR_GIT_URL=https://github.com/Hyland/ai-ready-index.git
HXPR_GIT_REF=main
# Pin to a specific commit SHA for reproducible builds (leave empty to track the branch tip).
HXPR_GIT_SHA=
MONGODB_TAG=8.2.5
OPENSEARCH_TAG=2.19.6
OPENSEARCH_ADMIN_PASSWORD=Hyland_Pass1!

# Nuxeo source build — consumed from the nuxeo-deployment companion project.
# Keep these in sync with nuxeo-deployment/.env.
NUXEO_GIT_TRACK=2025
NUXEO_GIT_REF=bf565575542bc0a77485dcbc51f691b243efbb01
NUXEO_SOURCE_ARCHIVE_URL=https://github.com/nuxeo/nuxeo/archive/bf565575542bc0a77485dcbc51f691b243efbb01.tar.gz
NUXEO_BUILD_THREADS=6
NUXEO_WEBUI_GIT_REF=0527b4c75cf3ee60183122b956b74f9a4a1159a5
NUXEO_WEBUI_VERSION=2025.18.0

# Remote source contexts — built by Docker/BuildKit, no local clone needed.
# To build from a local checkout instead, override in .env.local:
#   CONTENT_LAKE_GIT_CONTEXT=../content-lake-app
#   CONTENT_LAKE_APP_UI_CONTEXT=../content-lake-app-ui
CONTENT_LAKE_GIT_CONTEXT=https://github.com/AlfrescoLabs/content-lake-app.git#main
CONTENT_LAKE_ACS_GIT_CONTEXT=https://github.com/AlfrescoLabs/content-lake-app.git#main
CONTENT_LAKE_UI_GIT_CONTEXT=https://github.com/AlfrescoLabs/alfresco-content-lake-ui.git#main
CONTENT_LAKE_APP_UI_CONTEXT=https://github.com/AlfrescoLabs/content-lake-app-ui.git#main
ACA_TAG=7.4.1

# Nuxeo ingester settings
HXPR_NUXEO_TARGET_PATH=/nuxeo-sync
NUXEO_INCLUDED_ROOT_1=/default-domain/workspaces
NUXEO_DISCOVERY_MODE=CHILDREN
NUXEO_LIVE_AUDIT_ENABLED=true
NUXEO_LIVE_AUDIT_CURSOR_FILE=/data/audit-cursor.json

# HXPR build credentials are intentionally not stored here.
# Export these before running docker compose:
#   MAVEN_USERNAME
#   MAVEN_PASSWORD
#   NEXUS_USERNAME
#   NEXUS_PASSWORD
# Optional if the HXPR Git repository is not publicly cloneable:
#   HXPR_GIT_AUTH_TOKEN

# AI inference backend
#
# Both Docker Model Runner (Docker Desktop, dev) and the TEI + vLLM stack
# (compose.ai.yaml, prod) listen on host port 12434, so the same URL works
# for both — just switch which service occupies that port.
#
# Dev  — enable Docker Model Runner in Docker Desktop → it serves on :12434.
#         Pull models:  docker model pull ai/mxbai-embed-large
#                       docker model pull ai/qwen2.5
#
# Prod — start the GPU stack first:  docker compose -f compose.ai.yaml up -d
#         (or:  make start-ai)  then run the usual make up-* target.
#
# Spring AI appends /v1 itself, so keep the base URL at the service root.
MODEL_RUNNER_URL=http://host.docker.internal:12434
EMBEDDING_MODEL=ai/mxbai-embed-large
LLM_MODEL=ai/qwen2.5

# Public proxy port and bind address
PUBLIC_PORT=80
BIND_IP=0.0.0.0

# HTTPS (local self-signed). Set USE_HTTPS=true in .env.local after running
# scripts/generate-local-cert.sh to enable TLS termination at the nginx proxy.
USE_HTTPS=true
HTTPS_PORT=443

# Public base URL used by UI services (ACA, content-lake-app-ui).
# Leave empty (default) to let the UI use relative URLs — works with both HTTP
# and HTTPS because the nginx proxy forwards /alfresco/, /nuxeo/, /api/rag/.
# Set explicitly only for remote/non-loopback deployments:
#   PUBLIC_BASE_URL=https://your-domain.com
PUBLIC_BASE_URL=

# Alfresco Search Community (OpenSearch) batch indexer image tag
SEARCH_INDEXER_TAG=5.7.0
HXPR_USERNAME=admin
HXPR_PASSWORD=password
# Credentials for the filesystem batch ingester sync API (opt-in "filesystem" profile).
# Intentionally empty: the container refuses to start until both are set, so no known
# credential is published here. Set real values in .env.local.
CONNECTOR_SYNC_USERNAME=
CONNECTOR_SYNC_PASSWORD=
