# nginx.conf.template — substituted by envsubst at container startup.
#
# Variables injected by docker compose (set per Makefile target):
#   NGINX_SYNC_DEFAULT_BACKEND  e.g. batch-ingester:9090 or nuxeo-batch-ingester:9093
#   NGINX_ROOT_DIRECTIVE        e.g. "return 302 /aca/;"  or  "proxy_pass http://content-lake-app-ui:80;"
#   SERVER_NAME                 e.g. localhost (default) or demo.example.com
#
# HTTPS is handled by the compose entrypoint: when USE_HTTPS=true and
# /etc/nginx/certs/server.crt exists the HTTP block emits a redirect to HTTPS
# and the HTTPS block below is written into the final nginx.conf.

worker_processes  1;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    resolver 127.0.0.11 ipv6=off valid=30s;

    # Route /api/sync to the appropriate batch-ingester.
    #
    # The plugin host's key cannot be hard-coded, because the source type it serves is whatever the mounted
    # connector jar declares and that is unknown when this file is rendered. So the deployment states it:
    # NGINX_CONNECTOR_SOURCE_TYPE carries CONNECTOR_SOURCE_TYPE, and falls back to a sentinel that no real
    # source type can equal, which keeps the map syntactically valid when the connector profile is not in use.
    # Do not also list a shipped connector's type literally here: nginx refuses to start on a duplicate map
    # key, so `sharepoint` as both a literal and the variable's value would break every deployment.
    map $arg_sourceType $sync_backend {
        default    ${NGINX_SYNC_DEFAULT_BACKEND};
        ""         ${NGINX_SYNC_DEFAULT_BACKEND};
        alfresco   batch-ingester:9090;
        # The second Alfresco instance (opt-in alfresco-2 profile). Resolved per request like every other
        # backend here, so it answers 502 on a stack without that profile.
        alfresco2  batch-ingester-2:9090;
        nuxeo      nuxeo-batch-ingester:9093;
        ${NGINX_CONNECTOR_SOURCE_TYPE} plugin-batch-ingester:9096;
    }

    # ── HTTP server ─────────────────────────────────────────────────────────────
    # When USE_HTTPS=true the entrypoint injects "return 301 https://$host$request_uri;"
    # immediately after the listen directive via the placeholder below.
    server {

        listen *:80;
        server_name ${SERVER_NAME};

        ##HTTPS_REDIRECT_PLACEHOLDER##

        client_max_body_size 0;

        set  $allowOriginSite *;
        proxy_pass_request_headers on;
        proxy_pass_header Set-Cookie;

        proxy_connect_timeout 600;
        proxy_send_timeout    600;
        proxy_read_timeout    600;
        send_timeout          600;

        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
        proxy_redirect off;
        proxy_buffering off;
        proxy_set_header Host            $host:$server_port;
        proxy_set_header X-Real-IP       $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass_header Set-Cookie;

        set $batch_ingester_upstream batch-ingester:9090;
        set $rag_service_upstream    rag-service:9091;
        set $control_center_upstream control-center:8080;
        set $alfresco_upstream       alfresco:8080;
        set $share_upstream          share:8080;
        set $content_app_upstream    content-app:8080;
        set $demo_ui_upstream        content-lake-app-ui:80;
        # Opt-in service: a variable rather than a literal upstream so the resolver above looks it up per
        # request. nginx therefore starts, and answers 502, on a stack without the connector profile, instead
        # of refusing to boot on an unresolvable host name.
        set $plugin_host_upstream    plugin-batch-ingester:9096;

        location ~ ^(/.*/service/api/solr/.*)$             { return 403; }
        location ~ ^(/.*/s/api/solr/.*)$                   { return 403; }
        location ~ ^(/.*/wcservice/api/solr/.*)$           { return 403; }
        location ~ ^(/.*/wcs/api/solr/.*)$                 { return 403; }
        location ~ ^(/.*/proxy/alfresco/api/solr/.*)$      { return 403; }
        location ~ ^(/.*/-default-/proxy/alfresco/api/.*)$ { return 403; }

        location /api/rag/chat/stream {
            proxy_pass http://$rag_service_upstream;
            proxy_next_upstream off;
            proxy_read_timeout 300s;
            proxy_cache off;
        }

        # The caller's own Authorization header is forwarded to the ingester, which authenticates it
        # against the source repository. The proxy never supplies credentials of its own.
        location /api/sync {
            if ($sync_backend = "") { return 404; }
            proxy_pass http://$sync_backend;
        }

        location /api/content-lake {
            proxy_pass http://$batch_ingester_upstream;
        }

        location /api/rag {
            proxy_pass http://$rag_service_upstream;
        }

        # Operational status snapshot (rag-service, authenticated).
        location /api/status {
            proxy_pass http://$rag_service_upstream;
            proxy_hide_header WWW-Authenticate;
        }

        # ── The plugin host's operator endpoints (opt-in `connector` profile) ───────
        #
        # Routed same-origin so a browser-based UI needs no cross-origin configuration, and so the credential
        # it already sends to this origin is the one that arrives. The host's own port 9096 stays published:
        # diagnosing a jar that did not load must not depend on the proxy being right.
        #
        # WWW-Authenticate is stripped on every one of these, as it already is on /api/status. Each ingester is
        # default-deny, so an unauthenticated call answers 401 with a Basic challenge, and a browser that sees
        # that header raises its own native password box over the application. Hiding it lets the UI handle the
        # 401 itself. This is a precondition of the Sources screen, not a refinement of it.

        # Loaded connectors and their published settings schema. Descriptors only, never values.
        location /api/connectors {
            proxy_pass http://$plugin_host_upstream;
            proxy_hide_header WWW-Authenticate;
        }

        # The connector's own last-run summary, which is a different document from rag-service's /api/status.
        # Deliberately not mounted at /api/status: that path belongs to rag-service, the demo UI compares it by
        # exact equality, and moving it would break the status screen and the UI's auth interceptor together.
        location /api/connector-status {
            proxy_pass http://$plugin_host_upstream/api/status;
            proxy_hide_header WWW-Authenticate;
        }

        # Folder tree for the picker: roots, one node, one page of children.
        location /api/browse {
            proxy_pass http://$plugin_host_upstream;
            proxy_hide_header WWW-Authenticate;
        }

        # Which roots the connector syncs. The one write path here, and its blast radius is scope only.
        location /api/selection {
            proxy_pass http://$plugin_host_upstream;
            proxy_hide_header WWW-Authenticate;
        }

        # MCP server endpoint (rag-service). Authenticated like every other rag route; SSE-friendly.
        location /mcp {
            proxy_pass http://$rag_service_upstream;
            proxy_buffering off;
            proxy_read_timeout 300s;
        }

        location /admin {
            proxy_pass http://$control_center_upstream;
        }

        location /alfresco/ {
            proxy_pass http://$alfresco_upstream;
        }

        location /api-explorer/ {
            proxy_pass http://$alfresco_upstream;
        }

        location = /nuxeo {
            return 301 /nuxeo/;
        }

        location /nuxeo/ {
            proxy_pass http://host.docker.internal:8081;
        }

        location /share/ {
            proxy_pass http://$share_upstream;
        }

        location = /aca {
            return 301 /aca/;
        }

        location /aca/ {
            rewrite ^/aca(/.*)$ $1 break;
            proxy_pass http://$content_app_upstream;
            sub_filter_once on;
            sub_filter_types text/html;
            sub_filter '<base href="/">' '<base href="/aca/">';
            sub_filter 'href="/' 'href="/aca/';
            sub_filter 'src="/' 'src="/aca/';
        }

        location / {
            ${NGINX_ROOT_DIRECTIVE}
        }
    }

    # ── HTTPS server (local self-signed) ────────────────────────────────────────
    # This block is included verbatim by the entrypoint only when USE_HTTPS=true.
    ##HTTPS_SERVER_BLOCK_START##
    server {

        listen 443 ssl;
        http2 on;
        server_name ${SERVER_NAME};

        ssl_certificate     /etc/nginx/certs/server.crt;
        ssl_certificate_key /etc/nginx/certs/server.key;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
        ssl_prefer_server_ciphers off;

        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;

        client_max_body_size 0;

        set  $allowOriginSite *;
        proxy_pass_request_headers on;
        proxy_pass_header Set-Cookie;

        proxy_connect_timeout 600;
        proxy_send_timeout    600;
        proxy_read_timeout    600;
        send_timeout          600;

        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
        proxy_redirect off;
        proxy_buffering off;
        proxy_set_header Host            $host;
        proxy_set_header X-Real-IP       $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass_header Set-Cookie;

        set $batch_ingester_upstream batch-ingester:9090;
        set $rag_service_upstream    rag-service:9091;
        set $control_center_upstream control-center:8080;
        set $alfresco_upstream       alfresco:8080;
        set $share_upstream          share:8080;
        set $content_app_upstream    content-app:8080;
        set $demo_ui_upstream        content-lake-app-ui:80;
        # Opt-in service: a variable rather than a literal upstream so the resolver above looks it up per
        # request. nginx therefore starts, and answers 502, on a stack without the connector profile, instead
        # of refusing to boot on an unresolvable host name.
        set $plugin_host_upstream    plugin-batch-ingester:9096;

        location ~ ^(/.*/service/api/solr/.*)$             { return 403; }
        location ~ ^(/.*/s/api/solr/.*)$                   { return 403; }
        location ~ ^(/.*/wcservice/api/solr/.*)$           { return 403; }
        location ~ ^(/.*/wcs/api/solr/.*)$                 { return 403; }
        location ~ ^(/.*/proxy/alfresco/api/solr/.*)$      { return 403; }
        location ~ ^(/.*/-default-/proxy/alfresco/api/.*)$ { return 403; }

        location /api/rag/chat/stream {
            proxy_pass http://$rag_service_upstream;
            proxy_next_upstream off;
            proxy_read_timeout 300s;
            proxy_cache off;
        }

        # The caller's own Authorization header is forwarded to the ingester, which authenticates it
        # against the source repository. The proxy never supplies credentials of its own.
        location /api/sync {
            if ($sync_backend = "") { return 404; }
            proxy_pass http://$sync_backend;
        }

        location /api/content-lake {
            proxy_pass http://$batch_ingester_upstream;
        }

        location /api/rag {
            proxy_pass http://$rag_service_upstream;
        }

        # Operational status snapshot (rag-service, authenticated).
        location /api/status {
            proxy_pass http://$rag_service_upstream;
            proxy_hide_header WWW-Authenticate;
        }

        # ── The plugin host's operator endpoints (opt-in `connector` profile) ───────
        #
        # Routed same-origin so a browser-based UI needs no cross-origin configuration, and so the credential
        # it already sends to this origin is the one that arrives. The host's own port 9096 stays published:
        # diagnosing a jar that did not load must not depend on the proxy being right.
        #
        # WWW-Authenticate is stripped on every one of these, as it already is on /api/status. Each ingester is
        # default-deny, so an unauthenticated call answers 401 with a Basic challenge, and a browser that sees
        # that header raises its own native password box over the application. Hiding it lets the UI handle the
        # 401 itself. This is a precondition of the Sources screen, not a refinement of it.

        # Loaded connectors and their published settings schema. Descriptors only, never values.
        location /api/connectors {
            proxy_pass http://$plugin_host_upstream;
            proxy_hide_header WWW-Authenticate;
        }

        # The connector's own last-run summary, which is a different document from rag-service's /api/status.
        # Deliberately not mounted at /api/status: that path belongs to rag-service, the demo UI compares it by
        # exact equality, and moving it would break the status screen and the UI's auth interceptor together.
        location /api/connector-status {
            proxy_pass http://$plugin_host_upstream/api/status;
            proxy_hide_header WWW-Authenticate;
        }

        # Folder tree for the picker: roots, one node, one page of children.
        location /api/browse {
            proxy_pass http://$plugin_host_upstream;
            proxy_hide_header WWW-Authenticate;
        }

        # Which roots the connector syncs. The one write path here, and its blast radius is scope only.
        location /api/selection {
            proxy_pass http://$plugin_host_upstream;
            proxy_hide_header WWW-Authenticate;
        }

        # MCP server endpoint (rag-service). Authenticated like every other rag route; SSE-friendly.
        location /mcp {
            proxy_pass http://$rag_service_upstream;
            proxy_buffering off;
            proxy_read_timeout 300s;
        }

        location /admin {
            proxy_pass http://$control_center_upstream;
        }

        location /alfresco/ {
            proxy_pass http://$alfresco_upstream;
        }

        location /api-explorer/ {
            proxy_pass http://$alfresco_upstream;
        }

        location = /nuxeo {
            return 301 /nuxeo/;
        }

        location /nuxeo/ {
            proxy_pass http://host.docker.internal:8081;
        }

        location /share/ {
            proxy_pass http://$share_upstream;
        }

        location = /aca {
            return 301 /aca/;
        }

        location /aca/ {
            rewrite ^/aca(/.*)$ $1 break;
            proxy_pass http://$content_app_upstream;
            sub_filter_once on;
            sub_filter_types text/html;
            sub_filter '<base href="/">' '<base href="/aca/">';
            sub_filter 'href="/' 'href="/aca/';
            sub_filter 'src="/' 'src="/aca/';
        }

        location / {
            ${NGINX_ROOT_DIRECTIVE}
        }
    }
    ##HTTPS_SERVER_BLOCK_END##

    # Extra server blocks are spliced in after this line by an override file's proxy command (the
    # alfresco-2 profile inserts nginx/alfresco-2.conf.template here). Without one it stays a comment.
    ##EXTRA_SERVER_BLOCKS##
}
